# =============================================================================
# rotativo-pix — variáveis de ambiente (copie para .env e ajuste)
# NUNCA versione o .env real (está no .gitignore).
# =============================================================================

# Porta HTTP do microserviço
PORT=3000

# Segredo para assinar os JWT (HS256). TROQUE por um valor forte e único.
JWT_SECRET=troque-por-um-segredo-forte

# (Opcional) Senha do certificado mTLS, se o .pfx/.p12/.pem for protegido.
# CERT_PASSPHRASE=

# -----------------------------------------------------------------------------
# RabbitMQ (fila do webhook). NÃO publique a porta 5672 na internet.
# Dentro do docker-compose o host é o nome do serviço: rabbitmq.
# -----------------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# -----------------------------------------------------------------------------
# Banco de dados do backend (o worker escreve direto aqui, replicando confirm()).
#
# DB_POR_AMBIENTE=false  -> UM banco só (bloco DB_* abaixo) para sandbox e produção.
# DB_POR_AMBIENTE=true   -> bancos separados: use DB_SANDBOX_* e DB_PRODUCAO_*.
# -----------------------------------------------------------------------------
DB_POR_AMBIENTE=false

# Banco único (quando DB_POR_AMBIENTE=false)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rotativo
DB_USERNAME=rotativo_pix
DB_PASSWORD=troque-por-uma-senha-forte
# DB_POOL_LIMIT=10

# Placeholders para DB_POR_AMBIENTE=true (descomente e preencha quando for usar):
# DB_SANDBOX_HOST=
# DB_SANDBOX_PORT=3306
# DB_SANDBOX_DATABASE=
# DB_SANDBOX_USERNAME=
# DB_SANDBOX_PASSWORD=
#
# DB_PRODUCAO_HOST=
# DB_PRODUCAO_PORT=3306
# DB_PRODUCAO_DATABASE=
# DB_PRODUCAO_USERNAME=
# DB_PRODUCAO_PASSWORD=

# -----------------------------------------------------------------------------
# Worker (ajuste fino — valores padrão já são bons para produção)
# -----------------------------------------------------------------------------
# WORKER_PREFETCH=10
# WORKER_RETRY_TRANSIENT=3
# WORKER_RETRY_BACKOFF_MS=500
# WORKER_MAX_TENTATIVAS_GERACAO=5
# WORKER_REQUEUE_DELAY_MS=3000

# Retenção dos arquivos de webhook em disco (dias). Padrão 90.
# WEBHOOK_RETENCAO_DIAS=90
