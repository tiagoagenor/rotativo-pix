    "listar_cobrancas":              { "metodo": "GET",    "path": "/cob",                           "descricao": "Lista cobranças por período" },

    "criar_cobranca_vencimento":     { "metodo": "PUT",    "path": "/cobv/{txid}",                   "descricao": "Cria cobrança com vencimento" },
    "revisar_cobranca_vencimento":   { "metodo": "PATCH",  "path": "/cobv/{txid}",                   "descricao": "Altera cobrança com vencimento" },
