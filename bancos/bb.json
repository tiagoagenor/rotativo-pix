    "criar_lote_cobv":               { "metodo": "PUT",    "path": "/lotecobv/{id}",                 "descricao": "Cria lote de cobranças com vencimento" },
    "consultar_lote_cobv":           { "metodo": "GET",    "path": "/lotecobv/{id}",                 "descricao": "Consulta lote de cobranças" },

    "consultar_pix":                 { "metodo": "GET",    "path": "/pix/{e2eid}",                   "descricao": "Consulta um Pix recebido pelo endToEndId" },
    "listar_pix":                    { "metodo": "GET",    "path": "/pix",                           "descricao": "Lista Pix recebidos por período" },
    "solicitar_devolucao":           { "metodo": "PUT",    "path": "/pix/{e2eid}/devolucao/{id}",    "descricao": "Solicita devolução de um Pix" },
    "consultar_devolucao":           { "metodo": "GET",    "path": "/pix/{e2eid}/devolucao/{id}",    "descricao": "Consulta uma devolução" },

    "criar_location":                { "metodo": "POST",   "path": "/loc",                           "descricao": "Cria uma location (reserva de QR)" },
    "listar_locations":              { "metodo": "GET",    "path": "/loc",                           "descricao": "Lista locations" },
    "consultar_location":            { "metodo": "GET",    "path": "/loc/{id}",                      "descricao": "Consulta uma location" },
    "qrcode_da_location":            { "metodo": "GET",    "path": "/loc/{id}/qrcode",               "descricao": "Obtém o QR de uma location" },
    "desvincular_txid_location":     { "metodo": "DELETE", "path": "/loc/{id}/txid",                 "descricao": "Desvincula o txid de uma location" },

    "configurar_webhook":            { "metodo": "PUT",    "path": "/webhook/{chave}",               "descricao": "Registra a URL de webhook por chave Pix" },
    "consultar_webhook":             { "metodo": "GET",    "path": "/webhook/{chave}",               "descricao": "Consulta o webhook de uma chave" },
    "excluir_webhook":               { "metodo": "DELETE", "path": "/webhook/{chave}",               "descricao": "Remove o webhook de uma chave" }
