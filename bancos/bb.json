  "recursos": {
    "criar_cobranca":                { "metodo": "PUT",    "path": "/cob/{txid}",                    "descricao": "Cria cobrança imediata com txid" },
    "criar_cobranca_sem_txid":       { "metodo": "POST",   "path": "/cob",                           "descricao": "Cria cobrança imediata (BB gera o txid)" },
